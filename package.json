{
  "name": "worker-validation-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <25" },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/start.js",
    "web": "node --env-file-if-exists=.env src/web.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "queue:setup": "node --env-file-if-exists=.env src/queue-setup.js",
    "preview:ui": "node scripts/preview.js",
    "check": "node scripts/check.js",
    "build": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/*.test.js"
  },
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "pg": "8.23.0"
  }
}
