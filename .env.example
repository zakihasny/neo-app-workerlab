# Copy to .env for local development. Never commit actual credentials.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
NATS_USER=workerlab
NATS_PASSWORD=replace-with-a-different-url-safe-random-password
API_TOKEN=replace-with-an-independent-random-token-at-least-32-characters
# For direct Node execution, replace these URLs in full; dotenv does not interpolate.
DATABASE_URL=postgresql://workerlab:REPLACE_PASSWORD@127.0.0.1:55432/workerlab_local
NATS_URL=nats://workerlab:REPLACE_PASSWORD@127.0.0.1:14222
APP_ROLE=web
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
QUEUE_NAMESPACE=workerlab_local
WORKER_CONCURRENCY=1
RUN_MIGRATIONS_ON_START=false
QUEUE_AUTO_SETUP=false
